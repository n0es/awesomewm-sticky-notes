{
  "name": "sticky-notes",
  "version": "1.7.6",
  "description": "A high-performance sticky note app for AwesomeWM on Arch Linux, integrated with Obsidian.",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/n0es/awesomewm-sticky-notes.git"
  },
  "scripts": {
    "start": "electron .",
    "build": "esbuild src/renderer.js --bundle --outfile=dist/bundle.js",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.n0es.sticky-notes",
    "productName": "StickyNotes",
    "directories": {
      "output": "out"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "n0es",
        "repo": "awesomewm-sticky-notes"
      }
    ],
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "preload-menu.js",
      "index.html",
      "context-menu.html",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  },
  "keywords": [],
  "author": "n0es",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@chenglou/pretext": "^0.0.7",
    "chokidar": "^5.0.0",
    "marked": "^18.0.3"
  },
  "devDependencies": {
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0"
  }
}
